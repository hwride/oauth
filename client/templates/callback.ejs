<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Callback</title>
    <style>
      pre {
        max-width: 100%;
        overflow-x: auto;
        box-sizing: border-box;
      }

      .callback-failed {
        color: #b00020;
      }

    </style>
  </head>
  <body>
    <a href="/">Back to home</a>
    <h1 class="<%= callbackTitle === 'Callback failed' ? 'callback-failed' : '' %>">
      <%= callbackTitle %>
    </h1>

    <h2>Response</h2>
    <% if (errorMessage) { %>
    <p><%= errorMessage %></p>
    <% if (oauthError) { %>
    <dl>
      <dt>error</dt>
      <dd><%= oauthError %></dd>
      <% if (oauthErrorDescription) { %>
      <dt>error_description</dt>
      <dd><%= oauthErrorDescription %></dd>
      <% } %>
    </dl>
    <% } %>
    <% if (tokenResponseJson) { %>
    <h3>Error response body</h3>
    <pre><%= tokenResponseJson %></pre>
    <% } %>

    <% } else { %>
    <% if (tokenResponseJson) { %>
    <h3>Token response</h3>
    <pre><%= tokenResponseJson %></pre>
    <% } %>
    <% if (accessTokenJson) { %>
    <h3>Access token</h3>
    <pre><%= accessTokenJson %></pre>
    <% } else { %>
    <p>No access token present.</p>
    <% } %>
    <% if (idTokenJson) { %>
    <h3>ID token</h3>
    <pre><%= idTokenJson %></pre>
    <% } else { %>
    <p>No ID token present.</p>
    <% } %>
    <% } %>
  </body>
</html>
