{
  "name": "oauth",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:conformance": "node --env-file=conformance/conformance.env scripts/dev.ts",
    "test": "node --test otp/*.test.ts util/*.test.ts",
    "types": "tsc --noEmit",
    "prettier:write": "prettier --write .",
    "conformance:up": "docker compose -f conformance/docker-compose-prebuilt.yml -f conformance/proxy-compose.yml up --build",
    "conformance:down": "docker compose -f conformance/docker-compose-prebuilt.yml -f conformance/proxy-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-ejs": "^1.0.3"
  }
}
